# Salin ke .env lalu isi. JANGAN commit .env.
DOMAIN=rewardex.site
SECURE_COOKIE=1
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_DAYS=90
APP_PATH=
ADMIN_PATH=

# === Telegram (MadelineProto, multi-akun) ===
# Daftar di https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Login akun (bisa lebih dari satu) dibuat lewat:
#   docker compose run --rm telethon php login.php akun1
# Sesi tersimpan di ./data/tg (tidak perlu string session di sini).
# Secret internal antara Node ↔ service Telegram
TELEGRAM_SERVICE_SECRET=kodo-internal-ganti-ini

# === Telegram StringSession generator (GramJS) ===
# Sidecar ini memakai TELEGRAM_API_ID/HASH yang sama di atas.
# Secret internal Node ↔ generator (boleh beda dari service Telegram)
SESSION_GENERATOR_SECRET=kodo-generator-ganti-ini
# WAJIB untuk menyimpan StringSession (min. 8 karakter, acak, JANGAN diganti setelah ada data).
# Buat: openssl rand -base64 32
SESSION_ENC_KEY=
# URL internal (default untuk docker compose)
SESSION_GENERATOR_URL=http://session-generator:8091
