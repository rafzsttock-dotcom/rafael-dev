# Salin ke .env lalu isi. JANGAN commit .env.
DOMAIN=rewards.domainkamu.com     # kosongkan / ":80" jika belum punya domain (HTTP saja)
SECURE_COOKIE=1                   # set 0 jika tanpa HTTPS
ADMIN_PASSWORD=                   # min 10 karakter, panjang & acak
BOT_TOKEN=                        # dari @BotFather
BOT_USERNAME=                     # tanpa @
SESSION_DAYS=90
