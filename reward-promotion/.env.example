# Salin ke .env lalu isi. JANGAN commit .env.
DOMAIN=rewardex.site
SECURE_COOKIE=1
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_DAYS=90
APP_PATH=
ADMIN_PATH=

# === Telethon (ganti Bot API) ===
# Daftar di https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# String session dari: python telegram-service/make_session.py
TELEGRAM_SESSION=
# Secret internal antara Node ↔ Telethon service
TELEGRAM_SERVICE_SECRET=kodo-internal-ganti-ini
