# Ambil di https://my.telegram.org -> API Development Tools
TG_API_ID=123456
TG_API_HASH=your_api_hash_here

# Port yang didengarkan server (di dalam container)
PORT=8088

# Token akses untuk membuka tool ini sendiri (bukan token Telegram).
# Wajib panjang & acak, misal: openssl rand -hex 24
APP_ACCESS_TOKEN=ganti_dengan_token_acak_panjang

# Kunci untuk mengenkripsi StringSession sebelum disimpan ke disk.
# Wajib minimal 16 karakter, idealnya acak & panjang, misal: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=ganti_dengan_kunci_acak_panjang

# Folder penyimpanan data (biarkan default saat pakai Docker)
DATA_DIR=./data
