# ===========================================
# DetekLimitin / Bot Cek Bio - Environment
# Salin file ini ke .env dan isi nilainya
# ===========================================

# ---------- BOT TELEGRAM (WAJIB) ----------
BOT_TOKEN=ISI_TOKEN_BOT_TELEGRAM
BOT_USERNAME=namabotmu

# ---------- OWNER (WAJIB) ----------
OWNER_ID=123456789
OWNER_NAME=Owner
OWNER_TELEGRAM=username_owner

# ---------- FORCE SUBSCRIBE (opsional) ----------
# Pisahkan dengan koma. Contoh: @channel1,@channel2,-1001234567890
FORCE_SUB=

# ---------- LOGS CHANNEL (opsional) ----------
# Contoh: -1003796752797
CH_LOGS=

# ---------- SERVER ----------
PORT=5055
SERVER_PORT=5055
NODE_ENV=production

# ---------- TOKEN GUARD (sudah dinonaktifkan, biarkan 0) ----------
TOKEN_GUARD_DEBUG=0

# ---------- AUSTINPAY (Payment QRIS) ----------
# Daftar di https://austinstore.id
AUSTINPAY_API_KEY=
AUSTINPAY_API_SECRET=
AUSTINPAY_BASE_URL=https://austinstore.id

# ---------- PROXY (opsional, untuk OTP endpoint) ----------
PROXY_ENABLED=false
PROXY_TIMEOUT=10000
# Multi proxy pisah koma. Contoh: socks5://user:pass@host:1080,http://user:pass@host:8080
PROXY_URLS=
